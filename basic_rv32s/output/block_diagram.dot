digraph verilog_blocks {
  rankdir=LR;
  graph [fontname="Microsoft YaHei"];
  node [shape=box, style="rounded,filled", fillcolor="#eef4ff", fontname="Microsoft YaHei"];
  edge [color="#5667a6"];
  ALU [label="ALU\nIN: src_A, src_B, alu_op\nOUT: alu_result, alu_zero"];
  ALUController [label="ALUController\nIN: opcode, funct3, funct7_5, imm_10\nOUT: alu_op"];
  BranchLogic [label="BranchLogic\nIN: branch, branch_estimation, alu_zero, funct3, pc, imm\nOUT: branch_taken, branch_target_actual, branch_prediction_miss"];
  BranchPredictor [label="BranchPredictor\nIN: clk, reset, IF_opcode, IF_pc, IF_imm, EX_branch, EX_branch_taken\nOUT: branch_estimation, branch_target"];
  ByteEnableLogic [label="ByteEnableLogic\nIN: memory_read, memory_write, funct3, register_file_read_data, data_memory_read_data, address\nOUT: register_file_write_data, data_memory_write_data, write_mask"];
  CSRFile [label="CSRFile\nIN: clk, reset, trapped, csr_write_enable, csr_read_address, csr_write_address, csr_write_data, instruction_retired ...\nOUT: csr_read_out, csr_ready, current_mode, medeleg_out, mideleg_out, satp_out, mstatus_out, timer_interrupt_pending ..."];
  ControlUnit [label="ControlUnit\nIN: write_done, trap_done, csr_ready, IF_ID_stall, trap_jump, opcode, funct3\nOUT: jump, branch, alu_src_A_select, alu_src_B_select, csr_write_enable, register_file_write, register_file_write_data_select, memory_read ..."];
  EX_MEM_Register [label="EX_MEM_Register\nIN: clk, reset, flush, EX_MEM_stall, EX_pc, EX_pc_plus_4, EX_instruction, EX_memory_read ...\nOUT: MEM_pc, MEM_pc_plus_4, MEM_instruction, MEM_memory_read, MEM_memory_write, MEM_register_file_write_data_select, MEM_register_write_enable, MEM_csr_write_enable ..."];
  ExceptionDetector [label="ExceptionDetector\nIN: clk, reset, ID_opcode, EX_opcode, MEM_opcode, ID_funct3, EX_funct3, MEM_funct3 ...\nOUT: trapped, trap_status"];
  ForwardUnit [label="ForwardUnit\nIN: hazard_mem, hazard_wb, store_hazard_mem, store_hazard_wb, MEM_imm, MEM_alu_result, MEM_csr_read_data, byte_enable_logic_register_file_write_data ...\nOUT: alu_forward_source_data_a, alu_forward_source_data_b, alu_forward_source_select_a, alu_forward_source_select_b, store_forward_data, store_forward_enable, csr_forward_data"];
  Hardware_Multiplier [label="Hardware_Multiplier\nIN: src_A, src_B, mul_op\nOUT: mul_result"];
  HazardUnit [label="HazardUnit\nIN: clk, reset, trap_done, csr_ready, standby_mode, trap_status, misaligned_instruction_flush, misaligned_memory_flush ...\nOUT: hazard_mem, hazard_wb, csr_hazard_mem, csr_hazard_wb, store_hazard_mem, store_hazard_wb, IF_ID_flush, ID_EX_flush ..."];
  ID_EX_Register [label="ID_EX_Register\nIN: clk, reset, flush, ID_EX_stall, ID_pc, ID_pc_plus_4, ID_branch_estimation, ID_instruction ...\nOUT: EX_pc, EX_pc_plus_4, EX_branch_estimation, EX_instruction, EX_jump, EX_memory_read, EX_memory_write, EX_register_file_write_data_select ..."];
  IF_ID_Register [label="IF_ID_Register\nIN: clk, reset, flush, IF_ID_stall, IF_pc, IF_pc_plus_4, IF_instruction, IF_branch_estimation\nOUT: ID_pc, ID_pc_plus_4, ID_instruction, ID_branch_estimation"];
  ImmediateGenerator [label="ImmediateGenerator\nIN: raw_imm, opcode\nOUT: imm"];
  InstructionDecoder [label="InstructionDecoder\nIN: instruction\nOUT: opcode, funct3, funct7, rs1, rs2, rd, raw_imm"];
  MEM_WB_Register [label="MEM_WB_Register\nIN: clk, reset, MEM_WB_stall, flush, MEM_pc, MEM_pc_plus_4, MEM_instruction, MEM_register_file_write_data_select ...\nOUT: WB_pc, WB_pc_plus_4, WB_instruction, WB_register_file_write_data_select, WB_imm, WB_raw_imm, WB_csr_read_data, WB_alu_result ..."];
  MMIO_Interface [label="MMIO_Interface\nIN: clk, reset, data_memory_write_data, data_memory_address, data_memory_write_enable, UART_busy\nOUT: mmio_uart_tx_data, mmio_uart_status, mmio_uart_tx_start, mmio_uart_status_hit, mmio_led"];
  MMU [label="MMU\nIN: clk, reset, satp, mstatus, current_mode, tlb_wvpn, tlb_wpte, itlb_we ...\nOUT: if_physical_address, if_page_fault, mem_physical_address, mem_load_page_fault, mem_store_page_fault"];
  PCController [label="PCController\nIN: jump, ID_jump, branch_estimation, branch_prediction_miss, trapped, pc, jump_target, ID_jump_target ...\nOUT: next_pc"];
  PCPlus4 [label="PCPlus4\nIN: pc\nOUT: pc_plus_4"];
  ProgramCounter [label="ProgramCounter\nIN: clk, reset, next_pc\nOUT: pc"];
  RV32I46F5SPMMIO [label="RV32I46F5SPMMIO\nIN: clk, reset, UART_busy, timer_irq, external_irq, m_axi_if_awready, m_axi_if_wready, m_axi_if_bvalid ...\nOUT: retire_instruction, mmio_uart_tx_data, mmio_uart_tx_start, mmio_led, m_axi_if_awvalid, m_axi_if_awaddr, m_axi_if_awid, m_axi_if_awlen ..."];
  RV32_AXI_Adapter [label="RV32_AXI_Adapter\nIN: clk, reset, axi_awready, axi_wready, axi_bvalid, axi_arready, axi_rvalid, axi_rdata ...\nOUT: axi_awvalid, axi_awaddr, axi_awprot, axi_wvalid, axi_wdata, axi_wstrb, axi_bready, axi_arvalid ..."];
  RV32_SoC_AXI_Top [label="RV32_SoC_AXI_Top\nIN: clk, rst, UART_busy\nOUT: mmio_uart_tx_data, mmio_uart_tx_start, retire_instruction, mmio_led"];
  RegisterFile [label="RegisterFile\nIN: clk, read_reg1, read_reg2, write_reg, write_data, write_enable\nOUT: read_data1, read_data2"];
  RV32I46F5SPMMIO -> ALU [label="alu"];
  RV32I46F5SPMMIO -> Hardware_Multiplier [label="mul_inst"];
  RV32I46F5SPMMIO -> ALUController [label="alu_controller"];
  RV32I46F5SPMMIO -> BranchLogic [label="branch_logic"];
  RV32I46F5SPMMIO -> BranchPredictor [label="branch_predictor"];
  RV32I46F5SPMMIO -> ByteEnableLogic [label="byte_enable_logic"];
  RV32I46F5SPMMIO -> ControlUnit [label="control_unit"];
  RV32I46F5SPMMIO -> CSRFile [label="csr_file"];
  RV32I46F5SPMMIO -> MMU [label="mmu_inst"];
  RV32I46F5SPMMIO -> RV32_AXI_Adapter [label="data_axi_adapter"];
  RV32I46F5SPMMIO -> ExceptionDetector [label="exception_detector"];
  RV32I46F5SPMMIO -> ForwardUnit [label="forward_unit"];
  RV32I46F5SPMMIO -> HazardUnit [label="hazard_unit"];
  RV32I46F5SPMMIO -> ImmediateGenerator [label="immediate_generator"];
  RV32I46F5SPMMIO -> InstructionDecoder [label="instruction_decoder"];
  RV32I46F5SPMMIO -> MMIO_Interface [label="mmio_interface"];
  RV32I46F5SPMMIO -> ProgramCounter [label="program_counter"];
  RV32I46F5SPMMIO -> PCPlus4 [label="pc_plus_4"];
  RV32I46F5SPMMIO -> PCController [label="pc_controller"];
  RV32I46F5SPMMIO -> RegisterFile [label="register_file"];
  RV32I46F5SPMMIO -> IF_ID_Register [label="if_id_register"];
  RV32I46F5SPMMIO -> ID_EX_Register [label="id_ex_register"];
  RV32I46F5SPMMIO -> EX_MEM_Register [label="ex_mem_register"];
  RV32I46F5SPMMIO -> MEM_WB_Register [label="mem_wb_register"];
  RV32_SoC_AXI_Top -> RV32I46F5SPMMIO [label="cpu_core"];
}
